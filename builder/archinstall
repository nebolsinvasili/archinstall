#!/bin/bash
#  Author   : LinuxShef
#  EasyArch - Установщик ArchLinux
#
#  Точка входа: подключает модули из builder/lib и запускает установку.
#  Модули:
#    core.sh       - глобальные переменные и общие функции
#    ui.sh         - диалоги whiptail
#    pacman.sh     - pacman: конфигурация, база пакетов, зеркала
#    disk.sh       - диски и разделы
#    partition.sh  - ручная разметка диска
#    locale.sh     - язык, регион, локали
#    user.sh       - пользователи, оболочка, стандартные папки
#    hardware.sh   - драйверы видеокарт
#    bootloader.sh - загрузчик GRUB
#    desktop.sh    - рабочие столы и оконные менеджеры
#    kernel.sh     - ядра
#    menus.sh      - меню установщика
#    install.sh    - сценарии автоустановки и ручной установки

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SCRIPT_DIR/lib"

if [ ! -d "$LIB_DIR" ]; then
    echo "Не найден каталог модулей: $LIB_DIR" >&2
    echo "Скрипт нельзя запускать отдельно от каталога builder." >&2
    exit 1
fi

MODULES=(
    core
    ui
    pacman
    disk
    partition
    locale
    user
    hardware
    bootloader
    desktop
    kernel
    menus
    install
)

for module in "${MODULES[@]}"; do
    if [ ! -f "$LIB_DIR/$module.sh" ]; then
        echo "Не найден модуль: $LIB_DIR/$module.sh" >&2
        exit 1
    fi
    source "$LIB_DIR/$module.sh"
done

# Подготовка рабочей системы archiso
configure_archiso_pacman
cleanup_pacman_lock

main_installation
\
void Calculator::run(const Config& config) {\
    config_ = config;\
    \
    auto k_values = config_.k_values;\
    auto H_values = config_.H_values;\
    \
    std::sort(k_values.begin(), k_values.end());\
    std::sort(H_values.begin(), H_values.end());\
    \
    int totalCombinations = k_values.size() * H_values.size();\
    int completed = completed_combinations_.size();\
    int remaining = totalCombinations - completed;\
    \
    std::cout << "\n[DEBUG] Total combinations: " << totalCombinations << std::endl;\
    std::cout << "[DEBUG] Completed: " << completed << std::endl;\
    std::cout << "[DEBUG] Remaining: " << remaining << std::endl;\
    \
    log("Total combinations: " + std::to_string(totalCombinations));\
    log("Completed: " + std::to_string(completed));\
    log("Remaining: " + std::to_string(remaining));\
    \
    if (remaining == 0) {\
        log("All combinations already calculated.");\
        saveFinalResults();\
        printTopResults(config_.top_n);\
        return;\
    }\
    \
    ProgressBar progress(remaining, 50);\
    auto startTime = std::chrono::steady_clock::now();\
    processed_ = 0;\
    \
    bool startProcessing = !config_.resume;\
    double lastK = 0, lastH = 0;\
    if (config_.resume) {\
        loadCheckpoint(lastK, lastH);\
        std::cout << "[DEBUG] Checkpoint: k=" << lastK << ", H=" << lastH << std::endl;\
    }\
    \
    std::cout << "[DEBUG] Starting processing..." << std::endl;\
    \
    for (double k : k_values) {\
        for (double H : H_values) {\
            // Ѓ�роверка возобновлениу�\
            if (!startProcessing) {\
                if (isClose(k, lastK) && isClose(H, lastH)) {\
                    startProcessing = true;\
                    log("Resuming from k=" + std::to_string(k) + ", H=" + std::to_string(H));\
                    std::cout << "[DEBUG] Resuming from k=" << k << ", H=" << H << std::endl;\
                }\
                continue;\
            }\
            \
            // Ѓ�роверка у�же ву�полненну�у� комбинау�ий\
            if (isCombinationCompleted(k, H)) {\
                std::cout << "[DEBUG] Skipping: k=" << k << ", H=" << H << " (already completed)" << std::endl;\
                continue;\
            }\
            \
            processed_++;\
            std::cout << "[DEBUG] Processing: " << processed_ << "/" << remaining \
                      << " k=" << k << ", H=" << H << std::endl;\
            \
            processCombination(k, H);\
            \
            // Ѓ�бновление прогресса\
            progress.update(processed_, "k=" + std::to_string(k) + ", H=" + std::to_string(H));\
            \
            // Ѓ�оу�ранение контролу�ной тоу�ки\
            if (processed_ % config_.checkpoint_interval == 0) {\
                saveCheckpoint(k, H);\
            }\
        }\
    }\
    \
    auto endTime = std::chrono::steady_clock::now();\
    auto elapsed = std::chrono::duration_cast<std::chrono::seconds>(endTime - startTime).count();\
    \
    progress.finish("Complete! Time: " + formatTime(elapsed));\
    \
    log("Calculation completed: " + std::to_string(processed_) + " combinations");\
    log("Total time: " + formatTime(elapsed));\
    \
    saveFinalResults();\
    printTopResults(config_.top_n);\
}\
\
void Calculator::processCombination(double k, double H) {\
    try {\
        std::cout << "[DEBUG] Calculating ARL for k=" << k << ", H=" << H << std::endl;\
        double ARL = calculateARLParallel(k, H, config_.simulations, config_.n, \
                                          config_.max_iter, config_.n_cores);\
        std::cout << "[DEBUG] ARL = " << ARL << std::endl;\
        saveResult(k, H, ARL);\
        \
        // Ѓ�огирование прогресса в консолу�\
        std::cout << "\rProcessed: " << processed_ << " | k=" << k << ", H=" << H \
                  << ", ARL=" << ARL << "    " << std::flush;\
        \
    } catch (const std::exception& e) {\
        std::cerr << "[ERROR] Exception: " << e.what() << std::endl;\
        logError(k, H, e.what());\
    }\
}\
\
bool Calculator::isCombinationCompleted(double k, double H) const {\
    double rk = roundTo(k, 3);\
    double rH = roundTo(H, 3);\
    for (const auto& pair : completed_combinations_) {\
        if (isClose(pair.first, rk) && isClose(pair.second, rH)) {\
            return true;\
        }\
    }\
    return false;\
}\
\
void Calculator::saveResult(double k, double H, double ARL) {\
    // Ѓ�оу�рану�ем в паму�ту�\
    results_.push_back(std::make_tuple(k, H, ARL));\
    completed_combinations_.push_back({roundTo(k, 3), roundTo(H, 3)});\
    \
    // Ѓ�оу�рану�ем во временну�й у�айл\
    std::ofstream file(config_.temp_file, std::ios::app);\
    if (file.is_open()) {\
        file << k << "," << H << "," << ARL << "\n";\
        file.close();\
    }\
}\
\
void Calculator::saveCheckpoint(double k, double H) {\
    std::ofstream file(config_.checkpoint_file);\
    if (file.is_open()) {\
        file << k << "," << H << "\n";\
        file.close();\
    }\
}\
\
void Calculator::loadCheckpoint(double& k, double& H) {\
    k = 0;\
    H = 0;\
    if (fileExists(config_.checkpoint_file)) {\
        std::string content = readFile(config_.checkpoint_file);\
        auto parts = split(trim(content), ',');\
        if (parts.size() >= 2) {\
            k = std::stod(parts[0]);\
            H = std::stod(parts[1]);\
            log("Loaded checkpoint: k=" + std::to_string(k) + ", H=" + std::to_string(H));\
        }\
    }\
}\
\
void Calculator::loadCompletedCombinations() {\
    completed_combinations_.clear();\
    results_.clear();\
    \
    if (fileExists(config_.temp_file)) {\
        std::ifstream file(config_.temp_file);\
        std::string line;\
        int count = 0;\
        while (std::getline(file, line)) {\
            auto parts = split(trim(line), ',');\
            if (parts.size() >= 3) {\
                double k = std::stod(parts[0]);\
                double H = std::stod(parts[1]);\
                double ARL = std::stod(parts[2]);\
                completed_combinations_.push_back({roundTo(k, 3), roundTo(H, 3)});\
                results_.push_back(std::make_tuple(k, H, ARL));\
                count++;\
            }\
        }\
        file.close();\
        if (count > 0) {\
            log("Loaded " + std::to_string(count) + " completed combinations from temp file");\
        }\
    }\
}\
\
void Calculator::saveFinalResults() {\
    if (results_.empty()) {\
        log("No results to save");\
        return;\
    }\
    \
    // Удаление ду�бликатов\
    std::sort(results_.begin(), results_.end());\
    results_.erase(std::unique(results_.begin(), results_.end()), results_.end());\
    \
    // Ѓ�апису� у�иналу�ного у�айла\
    std::ofstream file(config_.final_file);\
    if (file.is_open()) {\
        file << "k,H,ARL\n";\
        for (const auto& r : results_) {\
            file << std::get<0>(r) << "," << std::get<1>(r) << "," << std::get<2>(r) << "\n";\
        }\
        file.close();\
        log("Saved " + std::to_string(results_.size()) + " results to " + config_.final_file);\
    }\
}\

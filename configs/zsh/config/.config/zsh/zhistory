Calculator::Calculator(const Config& config) : config_(config) {\
    loadCompletedCombinations();\
    log("=== CUSUM-SN ARL Calculator ===");\
    log("Configuration:");\
    log("  Simulations: " + std::to_string(config_.simulations));\
